POSTGRES_USER=norma
POSTGRES_PASSWORD=change-me
POSTGRES_DB=norma
POSTGRES_PORT=5436

# Embedding model. Changing it needs a re-index (python -m ingest.load); the table is recreated with the model's vector size.
EMBEDDING_MODEL=BAAI/bge-m3

# Local LLM (llama.cpp server). MODELS_DIR is a folder with GGUF files, mounted read-only.
MODELS_DIR=./models
MODEL_FILE=Llama-3.2-1B-Instruct-Q4_K_M.gguf
CTX_SIZE=4096
THREADS=6
LLAMA_PORT=8082
